# POSTGRES_CONNECTION=Host=127.0.0.1;Port=5434;Database=postgres;Username=postgres;Password=change-me
# # Preferred tag-based image settings.
# APP_IMAGE_REPOSITORY=ghcr.io/your-user/homeapp
# IMAGE_TAG=latest
# # Optional full override. If this is set, it wins over APP_IMAGE_REPOSITORY and IMAGE_TAG.
# # APP_IMAGE_REF=ghcr.io/your-user/homeapp:latest
# APP_PULL_POLICY=missing
# APP_PORT=5000
# # Bind app publishing to localhost when MESHNET_PROXY_ENABLED=true; the proxy owns the Meshnet IP.
# APP_BIND_IP=0.0.0.0
# # Optional host-level proxy for native Docker + Nord Meshnet.
# MESHNET_PROXY_ENABLED=false
# MESHNET_PROXY_IP=
# MESHNET_PROXY_PORT=5000
# MESHNET_PROXY_SERVICE=homeapp-meshnet-proxy
# # Build no-camera images with BUILD_WITH_CAMERAS=false.
# BUILD_WITH_CAMERAS=true
# WORKSPACES_HOST_PATH=../..
# MEDIA_SOURCE_PATH=/absolute/path/to/media
# # Additional sources use container-path=host-path entries separated by semicolons.
# # Add the container-side path (for example /mnt/drive1/Movies) in Video Library Sources.
# # ADDITIONAL_MEDIA_MOUNTS=/mnt/drive1=/absolute/path/to/drive1;/mnt/nas=/srv/media
# DOCUMENT_SOURCE_PATH=/absolute/path/to/documents
# RECORDED_VIDEO_HOST_PATH=./recorded_videos
# VIDEO_DEVICE_0=/dev/video0
# VIDEO_DEVICE_1=/dev/video1
# CONTAINER_VIDEO_DEVICE_0=/dev/video0
# CONTAINER_VIDEO_DEVICE_1=/dev/video1
# CAMERA_DEVICE=/dev/video0
# # Set when this host has camera devices and you want them mounted into the app.
# # COMPOSE_FILE_EXTRA=./docker-compose.cameras.yml
# MOVIE_PATH_ROOT=/mnt/movies
# MEDIA_BASE_URL=http://localhost:5000/media
# HOME_MEDIA_BASE_URL=http://<ip>:5000/media
# VLC_CONTROL_URL=http://host.docker.internal:6000/control
# VLC_CONTROL_TOKEN=replace-with-a-long-random-token
# VLC_PATH=/mnt/movies
# # Host-side VLC microservice. It is installed/updated by deploy.sh.
# VLC_HOST_SERVICE_ENABLED=true
# VLC_HOST_SERVICE_NAME=homeapp-vlc
# VLC_HOST_AUTO_INSTALL=true
# VLC_HOST_MEDIA_ROOT=/absolute/path/to/media
# VLC_CONTAINER_MEDIA_ROOT=/mnt/movies
# VLC_HOST_BIND=0.0.0.0
# VLC_HOST_PORT=6000
# # Allow only the deployed app's Docker subnet through UFW to the VLC port.
# VLC_HOST_CONFIGURE_UFW=true
# VLC_HOST_DISPLAY=:0
# # VLC_HOST_WAYLAND_DISPLAY=wayland-0
# # VLC_HOST_PULSE_SERVER=unix:/run/user/1000/pulse/native
# # VLC_HOST_USER=your-desktop-user
# OMDB_API_KEY=
# OMDB_DAILY_LIMIT=1000
# DISCORD_WEBHOOK_URL=
# FRONTEND_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# CAMERA_PUBLISHER_ENDPOINT=tcp://localhost:5555
# CAMERA_CONTROL_ENDPOINT=tcp://localhost:5556
# RECORDED_VIDEO_OUTPUT_FOLDER=/workspaces/HomeApp/recorded_videos
# POSTGRES_PORT=5434
# POSTGRES_DB=postgres
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=change-me
# PGADMIN_DEFAULT_EMAIL=admin@example.com
# PGADMIN_DEFAULT_PASSWORD=change-me
# PGADMIN_PORT=15435
# PROMETHEUS_PORT=9090
# LOKI_PORT=3100
# GRAFANA_PORT=3000
# JAEGER_UI_PORT=16686
# JAEGER_OTLP_GRPC_PORT=4317
# JAEGER_OTLP_HTTP_PORT=4318
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=change-me
# BASE_IP=localhost:5000
